{
  "file_format_version": "1.0.0",
  "layer": {
    "name": "VK_LAYER_RESHADEVK_overlay",
    "type": "GLOBAL",
    "library_path": "@library_path@",
    "api_version": "1.0.0",
    "implementation_version": "1",
    "description": "reshadeVK - Vulkan post-processing overlay layer",
    "functions": {
      "vkGetInstanceProcAddr": "reshadevk_GetInstanceProcAddr",
      "vkGetDeviceProcAddr":   "reshadevk_GetDeviceProcAddr"
    },
    "enable_environment": {
      "ENABLE_RESHADEVK": "1"
    },
    "disable_environment": {
      "DISABLE_RESHADEVK": "1"
    }
  }
}
